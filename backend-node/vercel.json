{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "../frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "../frontend/css/$1"
    },
    {
      "src": "/js/(.*)", 
      "dest": "../frontend/js/$1"
    },
    {
      "src": "/(.*)\\.(html|css|js)",
      "dest": "../frontend/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}